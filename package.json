{
  "name": "openttd-ai-api-mcp",
  "version": "0.3.0",
  "description": "Context7-style MCP server for the OpenTTD AI API documentation",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:http": "node src/http.js",
    "index": "node src/cli-index.js",
    "test": "node --test",
    "setup": "npm install && npm run index && npm run config",
    "config": "node scripts/write-configs.js",
    "connect": "node scripts/connect-client.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cheerio": "1.2.0",
    "minisearch": "7.2.0",
    "zod": "^4.0.0"
  }
}
